{
  "name": "digital-nomad-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "test": "jest --watchAll --verbose",
    "test:coverage": "jest --verbose --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npx expo-doctor && tsc --noEmit && npm run lint && npm run format:check && npm run test:coverage",
    "codegen": "graphql-codegen --config codegen.ts",
    "postinstall": "patch-package --error-on-fail --error-on-warn"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.1.1",
    "@tanstack/react-query": "^5.83.0",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.1.0",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.19",
    "nativewind": "5.0.0-rc.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.58.1",
    "react-native": "0.88.1",
    "react-native-css": "3.1.0-rc.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.67",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@react-native/jest-preset": "0.88.1",
    "@tailwindcss/postcss": "4.1.12",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.22",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "graphql": "^17.0.2",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "lightningcss": "1.30.1",
    "lint-staged": "^16.4.0",
    "lodash.clonedeep": "^4.5.0",
    "lodash.merge": "^4.6.2",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "reactotron-react-native": "^5.3.1",
    "tailwindcss": "4.1.12",
    "test-renderer": "~1.3.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "{src,app}/**/*.{ts,tsx}",
      "!src/test-utils/**",
      "!src/infra/storage/adapters/{KvStorage,SecureStorage}.ts",
      "!src/infra/graphql/{generated,__fixtures__}/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 90.92,
        "branches": 80.89,
        "functions": 91.4,
        "lines": 90.6
      }
    },
    "setupFiles": [
      "<rootDir>/setup-jest.tsx"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/setup-jest-after-env.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ],
    "resolver": "react-native-reanimated/jest/resolver"
  },
  "private": true,
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  }
}
