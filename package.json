{
  "name": "digital-nomad-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "test": "jest --watchAll --verbose",
    "test:coverage": "jest --verbose --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npx expo-doctor && tsc --noEmit && npm run lint && npm run format:check && npm run test:coverage"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/restyle": "^2.4.5",
    "@tanstack/react-query": "^5.83.0",
    "date-fns": "^4.1.0",
    "expo": "~56.0.24",
    "expo-constants": "~56.0.27",
    "expo-dev-client": "~56.0.28",
    "expo-font": "~56.0.7",
    "expo-image": "~56.0.13",
    "expo-linking": "~56.0.19",
    "expo-router": "~56.2.22",
    "expo-splash-screen": "~56.0.16",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.28",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.58.1",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-worklets": "0.8.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "29.5.14",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/react": "~19.2.14",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.6",
    "lint-staged": "^16.4.0",
    "lodash.clonedeep": "^4.5.0",
    "lodash.merge": "^4.6.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-test-renderer": "19.2.3",
    "reactotron-react-native": "^5.3.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "{src,app}/**/*.{ts,tsx}",
      "!src/test-utils/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 72.8,
        "branches": 67.21,
        "functions": 69.19,
        "lines": 72.39
      }
    },
    "setupFiles": [
      "<rootDir>/setup-jest.tsx"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ]
  },
  "private": true,
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  }
}
